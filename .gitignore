# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Large model / index artifacts (ai/models/) — keep these OUT of git.
# They live in the backup zip and are regenerated by the training notebook.
# ---------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.faiss
*.index
*.npy
*.npz

# The 10 MB FAISS-aligned metadata dump. Ignored as a large data artifact;
# it is what the products table will be seeded from. Delete this line if you
# decide you want it version-controlled after all.
ai/models/product_metadata.json

# Product images (id-based, served from backend/images/)
backend/images/*
!backend/images/.gitkeep

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
.next/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
/coverage

# ---------------------------------------------------------------------------
# Env files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
*.log
*.zip
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
