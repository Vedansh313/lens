# Lens frontend configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is committed.
#
# Vite exposes only variables prefixed with VITE_ to client code, and it inlines
# them at BUILD time rather than reading them at runtime. Two consequences:
#   * changing this file requires a rebuild (or a dev-server restart) to matter;
#   * whatever is here ends up readable in the shipped bundle, so it must never
#     hold a secret. There is nothing sensitive to put here — the API is the
#     only thing configured, and auth happens against it at runtime.

# Base URL of the Lens backend API.
# Local FastAPI server (this is also the fallback if the variable is unset):
VITE_API_URL=http://localhost:8000

# In a production build this must be set to the public API origin. If it is
# missing, the app throws on startup rather than silently calling localhost —
# which would otherwise look like "the backend is down" to every visitor.
# VITE_API_URL=https://api.your-domain.example
