# Lens backend configuration — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is committed. Never put a real password
# in this file.

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://lens:CHANGEME@localhost:5432/lens

# --- Optional overrides (server.py falls back to these defaults) ---
# Model artifacts live in the ai/ package; paths resolve relative to backend/.
# INDEX_PATH=../ai/models/product_index.faiss
# METADATA_PATH=../ai/models/product_metadata.json
# CLIP_WEIGHTS=../ai/models/clip_finetuned.pt
# IMAGES_DIR=./images

# Base URL used to build image_url values returned to the frontend.
# IMAGE_BASE_URL=http://localhost:8000
