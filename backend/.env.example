# Lens backend configuration — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is committed. Never put a real password,
# secret or hostname in this file.
#
# Everything except DATABASE_URL and JWT_SECRET has a working default for local
# development, so a fresh clone needs only those two to run.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://lens:CHANGEME@localhost:5432/lens

# ---------------------------------------------------------------------------
# Auth / JWT — REQUIRED
# ---------------------------------------------------------------------------
# Signing key for access and refresh tokens. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ROTATING THIS INVALIDATES EVERY ISSUED TOKEN, immediately and without warning:
# every signed-in user is signed out and every refresh token stops working, on
# every device. Nothing is revocable individually — the tokens are stateless and
# carry only a user id — so this key is the only revocation mechanism there is.
# Set the production value BEFORE the first real user signs in; rotating later
# is a deliberate, announced operation, not routine hygiene.
#
# A password change does NOT invalidate tokens (see set_password.py). If an
# account is compromised, rotating this key is what actually ends the
# attacker's session.
JWT_SECRET=CHANGEME_generate_with_python_secrets_token_urlsafe

# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS — required in production
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Any origin listed
# here can drive the API with a token the browser already holds, so list only
# your own frontend. Scheme, host and port must match exactly; no wildcards.
#
# The default (both spellings of the Vite dev server) applies when unset, so
# local development needs no entry. A deployment MUST set this.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Rate limiting (auth endpoints)
# ---------------------------------------------------------------------------
# Honour X-Forwarded-For when identifying the caller. Set to true ONLY when a
# trusted reverse proxy (nginx, a load balancer) terminates connections in front
# of the app.
#   Behind a proxy with this unset -> every user shares one bucket, because they
#     all appear to come from 127.0.0.1, and one attacker locks out everyone.
#   Directly exposed with this set -> the header is client-supplied, so anyone
#     can vary it per request and never hit a limit at all.
# Wrong either way unless it matches the deployment.
# TRUST_PROXY_HEADER=false

# Defaults shown. See backend/ratelimit.py for the reasoning, including why
# login is limited per-email as well as per-IP, and why an in-process limiter
# means running more than one uvicorn worker multiplies every limit.
# RATE_LIMIT_LOGIN_PER_MIN=5
# RATE_LIMIT_LOGIN_PER_EMAIL=5
# RATE_LIMIT_REGISTER_PER_HOUR=3

# Disables all rate limiting. For test suites only — never set in a deployment.
# RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Set to "production" on a deployed instance. The server then refuses to start
# if IMAGE_BASE_URL still points at localhost, which turns a silent
# misconfiguration (every product image 404s in the browser) into a boot error.
# LENS_ENV=development

# ---------------------------------------------------------------------------
# Model artifacts and images
# ---------------------------------------------------------------------------
# These files are NOT in git — roughly 1.3 GB in total, see README.md for how to
# obtain them. Paths resolve relative to backend/ when left unset.
# INDEX_PATH=../ai/models/product_index.faiss
# CLIP_WEIGHTS=../ai/models/clip_finetuned.pt
# IMAGES_DIR=./images

# Base URL used to build the image_url values returned to the frontend. This
# must be an address a BROWSER can reach: it is embedded in JSON responses, so
# "localhost" means the user's own machine, not the server. Set it to the public
# origin (or a CDN) in production.
# IMAGE_BASE_URL=http://localhost:8000
